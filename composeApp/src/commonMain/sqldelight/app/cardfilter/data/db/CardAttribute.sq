CREATE TABLE card_attribute (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    card_id INTEGER NOT NULL REFERENCES card(id),
    name TEXT NOT NULL,
    value TEXT NOT NULL
);

CREATE INDEX card_attribute_card_id ON card_attribute(card_id);

insert:
INSERT INTO card_attribute (card_id, name, value) VALUES (?, ?, ?);

deleteByCard:
DELETE FROM card_attribute WHERE card_id = ?;

deleteByTopic:
DELETE FROM card_attribute WHERE card_id IN (SELECT id FROM card WHERE topic_id = ?);
