CREATE TABLE quick_filter (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    topic_id INTEGER NOT NULL REFERENCES topic(id),
    name TEXT NOT NULL,
    include_query TEXT NOT NULL,
    exclude_query TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE INDEX quick_filter_topic_id ON quick_filter(topic_id);

selectByTopic:
SELECT id, topic_id, name, include_query, exclude_query FROM quick_filter
WHERE topic_id = ? ORDER BY created_at, id;

insert:
INSERT INTO quick_filter (topic_id, name, include_query, exclude_query, created_at) VALUES (?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

update:
UPDATE quick_filter SET name = ?, include_query = ?, exclude_query = ? WHERE id = ?;

delete:
DELETE FROM quick_filter WHERE id = ?;

deleteByTopic:
DELETE FROM quick_filter WHERE topic_id = ?;
